# Dependências
node_modules/

# Build (gerado por `npm run build`; o GitHub Actions recompila)
dist/
dist-ssr/

# Cache e arquivos gerados por ferramentas
.vite/
*.tsbuildinfo
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variáveis de ambiente e segredos
.env
.env.*
!.env.example

# Editores e IDEs (mantém só as configurações compartilhadas do VS Code)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Sistema operacional
.DS_Store
Thumbs.db

# Nix / direnv (se usar shell de desenvolvimento)
.direnv/
result
result-*

# ATENÇÃO: NÃO ignore o package-lock.json.
# O workflow de deploy usa `npm ci`, que exige o arquivo de lock no repositório.
